[Unit]
Description=Pride Blocks API
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pride-bank
Group=pride-bank
WorkingDirectory=/opt/pride-bank/current
EnvironmentFile=/etc/pride-bank/server.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/pride-bank/current/src/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/pride-bank

[Install]
WantedBy=multi-user.target
